{
  "$schema": "https://t3.codes/schema/t3.json",
  "iconPath": "assets/logo.svg",
  "scripts": [
    {
      "name": "Worktree Setup",
      "command": "uv sync && npm --prefix site ci",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Dev",
      "command": "npm --prefix site run dev -- --port 5173 --strictPort",
      "icon": "play",
      "stopOnSettle": true,
      "previewUrl": "http://localhost:5173",
      "autoOpenPreview": true
    },
    {
      "name": "Test Pipeline",
      "command": "uv run pytest",
      "icon": "test"
    },
    {
      "name": "Test Site",
      "command": "npm --prefix site test",
      "icon": "test"
    },
    {
      "name": "Build Site",
      "command": "npm --prefix site run build",
      "icon": "build"
    }
  ]
}
